#!/sbin/openrc-run
# Copyright 2026 Roman Asendorf
# Distributed under the terms of the BSD License

description="Gentoo system update via emerge"

command="/usr/local/bin/eup.sh"
command_background="yes"
pidfile="/run/$\{RC\_SVCNAME\}.pid"

depend() {
	after net
}

start() {
    ebegin "Starting update service"
    supervise-daemon "${RC_SVCNAME}" \
        --start \
        --pidfile "${pidfile}" \
        -- "${command}"
    eend $?
}

stop() {
    ebegin "Stopping update service"
    supervise-daemon "${RC_SVCNAME}" \
        --stop \
        --pidfile "${pidfile}"
    eend $?
}
